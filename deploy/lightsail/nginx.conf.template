map $http_upgrade $evmap_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name __IP__;
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / {
        return 308 https://__IP__$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name __IP__;
    ssl_certificate /etc/letsencrypt/live/evmap/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evmap/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:evmap_tls:5m;
    ssl_session_timeout 1d;
    client_max_body_size 6m;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $evmap_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
